# ==============================================================================
# YourAI — Environment Variables Template
# ==============================================================================
# SECURITY RULE: ALL variables below are SERVER-ONLY.
# NEVER prefix any of these variables with NEXT_PUBLIC_.
# Never commit real credentials, tokens, or production values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL via Supabase)
# ------------------------------------------------------------------------------
# Connection string to PostgreSQL. In production on Supabase, use the pooled or direct
# connection string. Never use the test database URL here.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication (Auth.js v5)
# ------------------------------------------------------------------------------
# High-entropy secret used to sign and encrypt JWT session cookies.
# Generate in bash/PowerShell with: openssl rand -base64 33
AUTH_SECRET="replace-with-a-random-32-byte-or-longer-secret"

# Canonical URL of the authentication instance (optional if AUTH_TRUST_HOST is set)
# AUTH_URL="https://yourai.example.com"

# Set to true when running behind a reverse proxy (Docker, Caddy, Vercel, Cloudflare Tunnel)
AUTH_TRUST_HOST=true

# ------------------------------------------------------------------------------
# 3. Application Security & Origin (CSRF Defense)
# ------------------------------------------------------------------------------
# Comma-separated list of trusted public origins.
# State-changing API requests (e.g. POST /api/generations/image) MUST carry a matching
# Origin header. Values are never derived from untrusted Host / X-Forwarded-* headers.
# Development falls back to "http://localhost:3000" if unset.
# In PRODUCTION, this is MANDATORY. If unset, generation requests are rejected with 403.
APP_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Cloudflare Workers AI (Image Inference)
# ------------------------------------------------------------------------------
# Cloudflare account ID and API token with "Workers AI: Read" permission.
# Model used: @cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_AI_API_TOKEN="your-workers-ai-api-token"

# ------------------------------------------------------------------------------
# 5. Supabase Storage (Private Asset Bucket)
# ------------------------------------------------------------------------------
# Administrative access to Supabase Storage (server-only).
# Use the service_role key or new secret key (sb_secret_...), NEVER the anon/public key.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_STORAGE_BUCKET="generated-assets"

# ------------------------------------------------------------------------------
# 6. Reverse Proxy & Network Trust Boundary (Rate Limiting)
# ------------------------------------------------------------------------------
# Set to "cloudflare" ONLY if network ingress guarantees direct client traffic
# to the origin server is impossible (e.g., Cloudflare Tunnel, Authenticated Origin Pulls).
# If direct access to the origin is possible, leave commented or set to "none" (default).
# CF-Ray and CF-Connecting-IP are NOT cryptographic proofs and can be forged by direct clients.
# TRUST_PROXY="none"

# ------------------------------------------------------------------------------
# 7. Disaster Recovery & Operational Tooling (Optional / Admin Only)
# ------------------------------------------------------------------------------
# Passphrase for AES-256-GCM encryption of database and storage backups.
# Enforced minimum 16 characters. Keep in a secure secrets manager.
# BACKUP_ENCRYPTION_KEY="your-strong-backup-passphrase-minimum-16-chars"

# ------------------------------------------------------------------------------
# 8. Test Suite Only (DO NOT SET IN PRODUCTION)
# ------------------------------------------------------------------------------
# Dedicated, isolated PostgreSQL database for running integration tests
# (scripts/test-accounting.mts, scripts/test-generation-integration.mts, scripts/test-image-queries-integration.mts).
# The test runner verifies that this is distinct from the primary database before running.
TEST_DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[TEST-PROJECT-REF].supabase.co:5432/postgres?schema=public"
