# ==============================================================================
# Pixora — Environment Variables Template
# ==============================================================================
# SECURITY RULE: ALL variables below are SERVER-ONLY.
# NEVER prefix any of these variables with NEXT_PUBLIC_.
# Never commit real credentials, tokens, or production values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL via Supabase)
# ------------------------------------------------------------------------------
# Connection string to PostgreSQL. In production on Supabase, use the pooled or direct
# connection string. Never use the test database URL here.
# TLS: append `sslmode=verify-full&sslrootcert=<absolute path to the Supabase root CA .crt>`. Without an
# sslmode the driver connects WITHOUT encryption. REQUIRED in production for any non-local database: the
# server refuses to start otherwise (src/lib/database-tls.ts). The Docker images ship the CA (pinned copy
# of config/tls/supabase-root-2021.crt) at /app/certs/supabase-root-2021.crt, so in containers use
#   ...?sslmode=verify-full&sslrootcert=/app/certs/supabase-root-2021.crt
# Outside Docker, point sslrootcert at the absolute path of config/tls/supabase-root-2021.crt.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public&sslmode=verify-full&sslrootcert=/app/certs/supabase-root-2021.crt"

# Optional. Used ONLY by the Prisma CLI (migrate deploy/status), whose schema engine takes different
# TLS parameters: `sslmode=require&sslcert=<CA path>&sslaccept=strict`. Must name the SAME database as
# DATABASE_URL or the CLI refuses to run (prisma/cli-database-url.ts). Not needed by the app or the build.
# MIGRATE_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require&sslcert=/path/to/supabase-root.crt&sslaccept=strict"

# ------------------------------------------------------------------------------
# 2. Authentication (Auth.js v5)
# ------------------------------------------------------------------------------
# High-entropy secret used to sign and encrypt JWT session cookies.
# Generate in bash/PowerShell with: openssl rand -base64 33
AUTH_SECRET="replace-with-a-random-32-byte-or-longer-secret"

# Canonical URL of the authentication instance (optional if AUTH_TRUST_HOST is set)
# AUTH_URL="https://pixora.example.com"

# Set to true when running behind a reverse proxy (Docker, Caddy, Vercel, Cloudflare Tunnel)
AUTH_TRUST_HOST=true

# ------------------------------------------------------------------------------
# 3. Application Security & Origin (CSRF Defense)
# ------------------------------------------------------------------------------
# Comma-separated list of trusted public origins.
# State-changing API requests (e.g. POST /api/generations/image) MUST carry a matching
# Origin header. Values are never derived from untrusted Host / X-Forwarded-* headers.
# Development falls back to "http://localhost:3000" if unset.
# In PRODUCTION, this is MANDATORY. If unset, generation requests are rejected with 403.
APP_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Cloudflare Workers AI (Image Inference)
# ------------------------------------------------------------------------------
# Cloudflare account ID and API token with "Workers AI: Read" permission.
# Model used: @cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_AI_API_TOKEN="your-workers-ai-api-token"

# ------------------------------------------------------------------------------
# 5. Supabase Storage (Private Asset Bucket)
# ------------------------------------------------------------------------------
# Administrative access to Supabase Storage (server-only).
# Use the service_role key or new secret key (sb_secret_...), NEVER the anon/public key.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
# REQUIRED in production (no default for image storage). The bucket must be PRIVATE with a
# 52,428,800-byte (50 MiB) file limit and allowed MIME types image/webp, video/mp4,
# video/quicktime, video/webm — see docs/runbooks/staging-setup-runbook.md (Phase 3).
SUPABASE_STORAGE_BUCKET="generated-assets"

# ------------------------------------------------------------------------------
# 6. Fal.ai Video Generation (Wan 2.1 Model)
# ------------------------------------------------------------------------------
# Video is OFF unless STAGE_8_QA_ALLOWLIST (below) is non-empty. When it is set, FAL_KEY is
# REQUIRED (startup validation fails without it). Leave both unset to keep video disabled.
# API Key for Fal.ai queue inference (format: "key_id:key_secret" or alphanumeric key).
# Used by FalVideoProvider to submit text-to-video jobs to https://queue.fal.run.
# FAL_KEY="your-fal-ai-api-key"
# Optional model override (default: fal-ai/wan/v2.1/t2v-720p).
# FAL_VIDEO_MODEL="fal-ai/wan/v2.1/t2v-720p"

# Public canonical URL for receiving asynchronous Ed25519-signed Fal.ai completion webhooks.
# Defaults to "${APP_ORIGIN}/api/webhooks/video/fal" if omitted.
# In staging/dev behind tunnels, set to your tunnel URL (e.g. "https://tunnel.example.com/api/webhooks/video/fal").
# FAL_WEBHOOK_URL="https://pixora.example.com/api/webhooks/video/fal"

# Secret used to generate and verify cryptographically bound delayed webhook correlation tokens.
# Must be a high-entropy string (min 16 chars). Defaults to AUTH_SECRET if omitted.
# WEBHOOK_CORRELATION_SECRET="replace-with-a-random-32-byte-secret"

# Bearer token for ALL THREE cron endpoints (GET /api/cron/video-webhooks, /api/cron/billing,
# /api/cron/clipper). REQUIRED in production: startup validation fails without it, and each endpoint
# rejects every request with 401 when it is unset (fails closed). Schedule them with an external
# cron (e.g. cron-job.org, GitHub Actions) passing:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-a-random-32-byte-secret"

# Video on-switch. Comma-separated user IDs (preferred) or verified emails allowed to generate
# videos. Empty/unset = video disabled for everyone (fails closed). Unlisted users get HTTP 403.
# NOTE: the app reads STAGE_8_QA_ALLOWLIST. The old documented name STAGE_8_QA_USER_EMAILS is NOT
# read; startup validation flags it if it is set without STAGE_8_QA_ALLOWLIST.
# STAGE_8_QA_ALLOWLIST="replace-with-qa-user-id"

# Comma-separated user IDs with access to admin/moderation tooling. Unset = no admins.
# ADMIN_USER_IDS="replace-with-admin-user-id"

# ------------------------------------------------------------------------------
# 6b. AI Video Clipper (Stage 9) — worker & limits (all optional except the opt-in)
# ------------------------------------------------------------------------------
# The clipper worker refuses to start unless this is "true". Production runs the bundled worker
# (Dockerfile target `clipper-worker`: `node --conditions=react-server dist/clipper-worker.mjs`);
# development uses `npm run clipper:worker`. It needs ffmpeg + ffprobe on PATH and the same
# DATABASE_URL / SUPABASE_URL / SUPABASE_SECRET_KEY / SUPABASE_STORAGE_BUCKET values as the app.
# CLIPPER_WORKER_ENABLED="false"
# Operator switch for NEW clip submissions (upload reservations + new jobs). It is NOT a worker
# health check. Production: ON only when exactly "true"; missing/blank/anything else = OFF
# (fails closed). Development: missing = ON, "false" = OFF, any other value = OFF.
# Set "true" only while a worker is actually being run.
# CLIPPER_SUBMISSIONS_ENABLED="false"
# Per-object upload cap in bytes (default 50 MB = Supabase Free per-file cap; verify the project's real limit).
# CLIPPER_MAX_UPLOAD_BYTES="52428800"
# CLIPPER_SCRATCH_DIR="/var/tmp/pixora-clipper"
# CLIPPER_RENDER_TIMEOUT_MS="600000"
# CLIPPER_FFMPEG_THREADS="2"
# Defaults shown (src/features/clipper/config.ts):
# CLIPPER_MAX_CLIPS_PER_JOB="3"
# CLIPPER_MIN_SOURCE_DURATION_SECONDS="15"
# CLIPPER_MAX_SOURCE_DURATION_SECONDS="300"
# GET /api/cron/clipper requires "Authorization: Bearer $CRON_SECRET" and FAILS CLOSED in
# production when CRON_SECRET is unset (the Stage 8 video cron does the same).

# ------------------------------------------------------------------------------
# 6c. Payments & receipts (purchases are DISABLED in production)
# ------------------------------------------------------------------------------
# No live payment gateway is integrated. In production every purchase route and the payment
# webhook return 503 PURCHASES_DISABLED, and the UI shows "Purchases coming soon". These are read
# only by code paths that are inactive in production; leave them unset there.
# RAZORPAY_WEBHOOK_SECRET=""     # reserved for a future verified Razorpay integration
# MOCK_WEBHOOK_SECRET=""         # development/test only; ignored (mock rejected) in production
# MOCK_PAYMENT_SECRET=""         # development/test only
# Receipt supplier details (optional; never invent a GSTIN):
# INVOICE_SUPPLIER_NAME=""
# INVOICE_SUPPLIER_ADDRESS=""
# INVOICE_SUPPLIER_GSTIN=""
# INVOICE_SUPPLIER_STATE_CODE=""
# INVOICE_PREFIX="RCPT"

# ------------------------------------------------------------------------------
# 7. Reverse Proxy & Network Trust Boundary (Rate Limiting)
# ------------------------------------------------------------------------------
# Set to "cloudflare" ONLY if network ingress guarantees direct client traffic
# to the origin server is impossible (e.g., Cloudflare Tunnel, Authenticated Origin Pulls).
# If direct access to the origin is possible, leave commented or set to "none" (default).
# CF-Ray and CF-Connecting-IP are NOT cryptographic proofs and can be forged by direct clients.
# TRUST_PROXY="none"

# ------------------------------------------------------------------------------
# 8. Disaster Recovery & Operational Tooling (Optional / Admin Only)
# ------------------------------------------------------------------------------
# Passphrase for AES-256-GCM encryption of database and storage backups.
# Enforced minimum 16 characters. Keep in a secure secrets manager.
# BACKUP_ENCRYPTION_KEY="your-strong-backup-passphrase-minimum-16-chars"

# ------------------------------------------------------------------------------
# 9. Test Suite Only (DO NOT SET IN PRODUCTION)
# ------------------------------------------------------------------------------
# Dedicated, isolated PostgreSQL database for running integration tests
# (scripts/test-accounting.mts, scripts/test-generation-integration.mts, scripts/test-image-queries-integration.mts).
# The test runner verifies that this is distinct from the primary database before running.
TEST_DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[TEST-PROJECT-REF].supabase.co:5432/postgres?schema=public"
