generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CreditTransactionType {
  INITIAL_GRANT
  PURCHASE
  GENERATION_DEBIT
  REFUND
  ADMIN_ADJUSTMENT
}

enum GenerationType {
  IMAGE
  VIDEO
  VIDEO_CLIP
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// bcrypt hash for email/password sign-in. Null for OAuth-only users.
  passwordHash  String?
  /// User tombstone flag: accounts with statutory financial history (PaymentOrder)
  /// are soft-deleted/anonymized to satisfy onDelete: Restrict constraints.
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  /// Account suspension flag: suspended accounts cannot sign in or generate media.
  isSuspended       Boolean              @default(false)
  suspendedAt       DateTime?
  suspensionReason  String?              @db.Text
  warningCount      Int                  @default(0)
  lastWarningAt     DateTime?
  lastWarningReason String?              @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  wallet        CreditWallet?
  transactions  CreditTransaction[]
  jobs          GenerationJob[]
  assets        GeneratedAsset[]
  usageLogs     UsageLog[]
  paymentOrders PaymentOrder[]
  reportsFiled   AbuseReport[]        @relation("Reporter")
  reportsAgainst AbuseReport[]        @relation("ReportedUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]
}

model CreditTransaction {
  id             String                @id @default(cuid())
  userId         String
  walletId       String
  type           CreditTransactionType
  amount         Int
  balanceAfter   Int
  description    String?
  idempotencyKey String                @unique
  /// Generation job this debit/refund belongs to (null for grants, purchases, adjustments).
  jobId          String?
  /// Payment order this purchase credit belongs to (unique: 1 payment order = at most 1 purchase credit).
  paymentOrderId String?               @unique
  createdAt      DateTime              @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       CreditWallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  job          GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  paymentOrder PaymentOrder?  @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([jobId])
  @@index([paymentOrderId])
}

model GenerationJob {
  id               String           @id @default(cuid())
  userId           String
  type             GenerationType
  status           GenerationStatus @default(PENDING)
  prompt           String?          @db.Text
  provider         String?
  providerJobId    String?
  estimatedCredits Int              @default(0)
  chargedCredits   Int              @default(0)
  errorMessage     String?          @db.Text
  /// Client-supplied key; a retried submission returns the existing job instead of creating a new one.
  idempotencyKey   String?
  /// Provider model identifier, e.g. "@cf/black-forest-labs/flux-1-schnell".
  model            String?
  /// Validated generation settings (e.g. { "quality": "fast", "steps": 4 }).
  settings         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  /// Set when the provider request starts; used to detect stuck jobs.
  startedAt               DateTime?
  completedAt             DateTime?
  /// Unique lease token claimed by an ingestion worker to stream and persist provider video output.
  ingestionToken          String?
  /// Expiration timestamp for the active ingestion lease; allows crash recovery after timeout.
  ingestionLeaseExpiresAt DateTime?

  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets             GeneratedAsset[]
  usage              UsageLog[]
  creditTransactions CreditTransaction[]
  budgetReservation  ProviderBudgetReservation?
  // Also enforced in migration SQL (not expressible in Prisma schema):
  // partial unique index "GenerationJob_one_active_per_user" on ("userId") WHERE status IN ('PENDING','PROCESSING').

  @@unique([provider, providerJobId])
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, ingestionLeaseExpiresAt])
}

model GeneratedAsset {
  id              String    @id @default(cuid())
  userId          String
  jobId           String
  type            AssetType
  /// Deprecated for private storage: use storageKey + short-lived signed URLs instead.
  fileUrl         String?   @db.Text
  /// Object key inside the private storage bucket, e.g. "users/{userId}/images/{jobId}/{assetId}.webp".
  storageKey      String
  width           Int?
  height          Int?
  mimeType        String?
  fileSize        BigInt?
  /// Duration of video or audio asset in seconds. Null for static images.
  durationSeconds Float?
  /// Object key in private storage for video poster frame thumbnail (WebP). Null for static images.
  thumbnailKey    String?
  /// Content moderation visibility: hidden assets cannot be downloaded or viewed in galleries.
  isHidden        Boolean   @default(false)
  hiddenAt        DateTime?
  hiddenBy        String?
  hiddenReason    String?   @db.Text
  createdAt       DateTime  @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([jobId])
}

model UsageLog {
  id            String   @id @default(cuid())
  userId        String
  jobId         String
  provider      String
  model         String
  inputUnits    Int      @default(0)
  outputUnits   Int      @default(0)
  actualCostUsd Decimal  @default(0) @db.Decimal(12, 6)
  createdAt     DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Provider capacity accounting (separate from user credit accounting).
// Neuron amounts are stored as integer centi-neurons (1/100 Neuron), because
// Cloudflare reports usage with two decimals (e.g. "172.80"). 9,500 Neurons = 950000.
// ---------------------------------------------------------------------------

enum BudgetReservationStatus {
  RESERVED // held for an in-flight job
  CONSUMED // provider ran; settled with actual usage
  RELEASED // provider never ran; capacity returned
}

/// One row per provider per UTC day (Cloudflare resets limits at 00:00 UTC).
/// Reservations use a single conditional UPDATE so concurrent requests cannot exceed the limit.
model ProviderDailyBudget {
  id                   String   @id @default(cuid())
  provider             String
  /// UTC calendar day this budget covers.
  day                  DateTime @db.Date
  limitCentiNeurons    Int
  /// Capacity held by RESERVED (in-flight) reservations.
  reservedCentiNeurons Int      @default(0)
  /// Actual provider usage of CONSUMED reservations.
  consumedCentiNeurons Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  reservations ProviderBudgetReservation[]

  @@unique([provider, day])
}

/// Exactly one reservation per job. Settlement is a guarded transition
/// (UPDATE ... WHERE status = 'RESERVED'), so it can happen only once.
model ProviderBudgetReservation {
  id                   String                  @id @default(cuid())
  budgetId             String
  jobId                String                  @unique
  status               BudgetReservationStatus @default(RESERVED)
  reservedCentiNeurons Int
  /// Actual usage reported by the provider (cf-ai-neurons header), set on CONSUMED.
  actualCentiNeurons   Int?
  createdAt            DateTime                @default(now())
  settledAt            DateTime?

  budget ProviderDailyBudget @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  job    GenerationJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([budgetId, status])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Durable Webhook Ingestion & Outbox Events (Stage 8)
// Stores verified provider webhook payloads durably on disk/database before Fast-ACK.
// Supports safe worker claiming, crash recovery, and idempotent duplicate handling.
// ---------------------------------------------------------------------------

enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model ProviderWebhookEvent {
  id              String             @id @default(cuid())
  provider        String             // e.g. "fal-ai"
  eventId         String             @unique // provider request_id or gateway event id
  jobId           String?
  payload         Json
  status          WebhookEventStatus @default(PENDING)
  processingToken String?
  leaseExpiresAt  DateTime?
  attempts        Int                @default(0)
  lastError       String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([provider, status, leaseExpiresAt])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Payment Gateway, Order Settlement & Webhook Events (Stage 10 Batch 2)
// ---------------------------------------------------------------------------

enum PaymentOrderStatus {
  PENDING
  CREATION_UNKNOWN
  CREATED
  PAID
  FAILED
  EXPIRED
  REFUNDED
  NEEDS_REVIEW
}

enum PaymentAttemptStatus {
  INITIATED
  AUTHORIZED
  CAPTURED
  FAILED
}

model PaymentOrder {
  id               String             @id @default(cuid())
  userId           String
  receipt          String             @unique // Unique merchant receipt reference (e.g. rcpt_...)
  packageId        String             // e.g. "PKG_CREATOR"
  packageSnapshot  Json               // Immutable purchase-time package definition
  creditsAllocated Int                // Number of credits to allocate upon settlement
  currency         String             // "INR" | "USD"
  baseAmountMinor  Int                // Net amount excluding tax in minor units
  taxAmountMinor   Int                // Tax liability in minor units
  totalAmountMinor Int                // Gross charge in minor units
  status           PaymentOrderStatus @default(PENDING)
  gateway          String             // "razorpay" | "mock"
  gatewayOrderId   String?            // External gateway order ID
  gatewayPaymentId String?            // External gateway payment ID
  gatewaySignature String?            // Cryptographic payment signature
  reviewReason     String?            // Code explaining why order was transitioned to NEEDS_REVIEW
  metadata         Json?              // Client IP, user agent, risk flags, audit notes
  paidAt           DateTime?
  failedAt         DateTime?
  expiredAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  // Statutory financial audit retention: CASCADE is strictly prohibited.
  // Physical user row deletion is prevented by onDelete: Restrict.
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  creditTransaction CreditTransaction?
  attempts          PaymentAttempt[]

  @@unique([gateway, gatewayOrderId])
  @@unique([gateway, gatewayPaymentId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([gateway, gatewayOrderId])
}

model PaymentAttempt {
  id               String               @id @default(cuid())
  orderId          String
  gateway          String               // "razorpay" | "mock"
  gatewayOrderId   String?
  gatewayPaymentId String?
  status           PaymentAttemptStatus @default(INITIATED)
  amountMinor      Int
  currency         String
  errorCode        String?
  errorMessage     String?              @db.Text
  metadata         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  order PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([gateway, gatewayOrderId])
  @@index([gateway, gatewayPaymentId])
}

model PaymentWebhookEvent {
  id              String             @id @default(cuid())
  gateway         String             // "razorpay" | "mock"
  eventId         String             // Gateway webhook delivery ID
  eventType       String             // "payment.captured", "payment.failed", etc.
  payload         Json
  status          WebhookEventStatus @default(PENDING)
  processingToken String?            // Worker lease token
  leaseExpiresAt  DateTime?          // Crash recovery lease expiry
  attempts        Int                @default(0)
  lastError       String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([gateway, eventId])
  @@index([gateway, status, leaseExpiresAt])
}

enum AbuseReportCategory {
  CSAM
  EXTREME_VIOLENCE
  SELF_HARM
  HATE_SPEECH
  HARASSMENT
  COPYRIGHT_INFRINGEMENT
  SPAM_OR_ABUSE
  OTHER
}

enum ModerationQueueStatus {
  PENDING_REVIEW
  ACTIONED
  DISMISSED
}

enum ModerationAction {
  DISMISS
  HIDE_CONTENT
  SUSPEND_USER
  WARN_USER
}

model AbuseReport {
  id              String                @id @default(cuid())
  targetType      String                // "JOB" | "ASSET" | "USER"
  targetId        String
  category        AbuseReportCategory
  details         String                @db.Text
  status          ModerationQueueStatus @default(PENDING_REVIEW)
  reporterId      String?
  reportedUserId  String?
  reviewedBy      String?
  reviewedAt      DateTime?
  actionTaken     ModerationAction?
  resolutionNotes String?               @db.Text
  metadata        Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  reporter        User?                 @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedUser    User?                 @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  auditLogs       ModerationAuditLog[]

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reportedUserId])
  @@index([reporterId])
}

model ModerationAuditLog {
  id             String                 @id @default(cuid())
  reportId       String?
  operatorId     String
  action         ModerationAction
  targetType     String                 // "JOB" | "ASSET" | "USER"
  targetId       String
  reason         String                 @db.Text
  previousStatus ModerationQueueStatus?
  newStatus      ModerationQueueStatus?
  metadata       Json?
  createdAt      DateTime               @default(now())

  report         AbuseReport?           @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([targetType, targetId])
  @@index([operatorId, createdAt])
}
