# Dependencies & build outputs (rebuilt inside the image)
node_modules
.next
out
dist

# Git & editor
.git
.gitignore
.vscode
.idea

# Environment files & secrets — NEVER in the build context. Runtime values are injected by the
# platform as environment variables. Only the value-free template is allowed through.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.enc
certs
staging-security
# The ONE certificate allowed in: the public Supabase root CA (no private key), fingerprint-pinned in the Dockerfile.
!config/tls/supabase-root-2021.crt

# Backups & local dumps (migration SQL is applied by an operator from a reviewed checkout, never
# from the image — see docs/runbooks/staging-setup-runbook.md)
backups
*.dump
*.sql
*.sql.gz

# Local test/E2E artefacts
scripts/e2e/artifacts
tsconfig.tsbuildinfo

# Logs & temp files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo
